#!/bin/sh

agent=$1
state=$2
option="@${agent}_state"

# Keep Claude's non-interactive child sessions separate from the pane owner.
[ "$agent" != claude ] || [ "${CLAUDE_CODE_ENTRYPOINT:-cli}" = cli ] || option=@claude_post

# Codex sessions run under a shared app-server daemon, and that daemon's
# TMUX_PANE is frozen at daemon-start time, so it points at whichever pane
# started the daemon rather than the pane Codex is running in. Recover the real
# pane by matching the session cwd against panes whose foreground process is
# codex, falling back to $TMUX_PANE when the match is missing or ambiguous.
pane=${TMUX_PANE:-}
if [ "$agent" = codex ]; then
  session_cwd=$(pwd -P 2>/dev/null)
  if [ -n "$session_cwd" ]; then
    matches=$(tmux list-panes -a -F '#{pane_id}|#{pane_current_command}|#{pane_current_path}' 2>/dev/null \
      | awk -F'|' -v cwd="$session_cwd" '$2 == "codex" && $3 == cwd { print $1 }')
    count=$(printf '%s\n' "$matches" | grep -c .)
    [ "$count" -eq 1 ] && pane=$matches
  fi
fi

[ -n "$pane" ] || exit 0

# `start` is idle plus the session id and transcript path, which
# tmux-agent-resurrect.sh saves as `claude --resume <id>`.
session=
transcript=
if [ "$state" = start ]; then
  state=idle
  if [ "$option" = @claude_state ]; then
    input=$(cat)
    session=$(printf '%s\n' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([0-9a-f-]\{36\}\)".*/\1/p' | head -n 1)
    transcript=$(printf '%s\n' "$input" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
  fi
fi

if [ "$state" = end ]; then
  tmux set-option -p -u -t "$pane" "$option" 2>/dev/null || true
  if [ "$option" = @claude_state ]; then
    tmux set-option -p -u -t "$pane" @claude_session 2>/dev/null || true
    tmux set-option -p -u -t "$pane" @claude_transcript 2>/dev/null || true
  fi
else
  tmux set-option -p -t "$pane" "$option" "$state" 2>/dev/null || true
  if [ -n "$session" ]; then
    tmux set-option -p -t "$pane" @claude_session "$session" 2>/dev/null || true
    tmux set-option -p -t "$pane" @claude_transcript "$transcript" 2>/dev/null || true
  fi
fi
