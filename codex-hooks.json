{
  "description": "Publish Codex lifecycle state as a tmux pane option for the status bar.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex idle", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex working", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex working", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex working", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex waiting", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex idle", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex end", "timeout": 3 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "~/.local/bin/tmux-agent-state codex idle", "timeout": 3 }] }
    ]
  }
}